# ─────────────────────────────────────────────────────────────
# NordInvest v2 — environment variables
# Copy to .env.local for local dev; add the same keys in Vercel
# (Project → Settings → Environment Variables) for the preview.
# NEVER commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────

# Supabase (auth + database) — create a free project at supabase.com,
# then Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, keep secret

# App URL (used for OAuth redirects). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test mode first) — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=                # from `stripe listen` or the dashboard webhook

# Stripe Price IDs — create 3 recurring products (DKK/month) and paste price_… ids
STRIPE_PRICE_STARTER=                 # 129 DKK/md
STRIPE_PRICE_PRO=                     # 349 DKK/md
STRIPE_PRICE_UNLIMITED=               # 799 DKK/md

# OAuth is configured INSIDE Supabase (Auth → Providers), not here:
#   • LinkedIn (OIDC): client id + secret + redirect
#   • Google:          client id + secret + redirect
# Redirect URL to register with each provider:
#   https://<your-project>.supabase.co/auth/v1/callback
